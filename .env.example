# ---------------------------------------------------------------------------
# Lead Hunter core engine — environment. Copy to `.env` and fill in.
# Nothing here is required except DATABASE_URL; every external provider is
# optional and each adapter FAILS CLOSED when its credentials are missing.
# ---------------------------------------------------------------------------

# Postgres (docker compose up -d gives you exactly this)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

NODE_ENV=development

# Determinism: seed for the xoshiro128** RNG (bandits, sampling, simulation)
LEADHUNTER_SEED=20260101

# Operator identity used in audit logs and handoff instructions
LEADHUNTER_OPERATOR=operator

# Honest, identifiable User-Agent (never impersonate a browser; no rotation)
LEADHUNTER_USER_AGENT=LeadHunterBot/0.1 (+https://your-domain.example/lead-hunter; contact: you@your-domain.example)

# Privacy — retention purge window (days) and ORDELY note in docs/SOURCES.md.
# Law 18-07 reminder: only business-public contact data, honour access/erasure.
LEADHUNTER_RETENTION_DAYS=540

# Sender protection (human sends manually; these are policy caps enforced in code)
LEADHUNTER_DAILY_SEND_CAP=40
LEADHUNTER_HOURLY_SEND_CAP=6

# Read-only CSV of existing ORDELY customers to EXCLUDE (no live coupling).
# LEADHUNTER_ORDELY_CUSTOMERS_CSV=./var/ordely-customers.csv

# Link used in the reply.interested_link template
LEADHUNTER_ORDELY_URL=https://app.ordely.example/signup

# Safe fetcher politeness
LEADHUNTER_FETCH_RATE_PER_SECOND=0.5
LEADHUNTER_FETCH_CONCURRENCY_PER_DOMAIN=1
LEADHUNTER_FETCH_MAX_BYTES=2097152

# Daily provider budgets (cost accounting; 0 = provider disabled)
LEADHUNTER_PROVIDER_BUDGET_BRAVE=0
LEADHUNTER_PROVIDER_BUDGET_GOOGLE_CSE=0
LEADHUNTER_PROVIDER_BUDGET_GOOGLE_PLACES=0
LEADHUNTER_PROVIDER_BUDGET_SERPER=0

# --- Search providers (verified docs in docs/SOURCES.md) --------------------
# Brave Search API: GET https://api.search.brave.com/res/v1/web/search
# BRAVE_API_KEY=
# Google Programmable Search JSON API: GET https://www.googleapis.com/customsearch/v1
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# Google Places API (New) Text Search: POST https://places.googleapis.com/v1/places:searchText
# GOOGLE_PLACES_API_KEY=

# Serper — UNVERIFIED in Phase 0 (official docs unreachable). Fails closed until
# you re-verify the endpoint yourself and opt in explicitly.
# SERPER_API_KEY=
# LEADHUNTER_ENABLE_SERPER=false

# Meta Ad Library API — OFF by default: the reference documents ad_reached_countries
# (includes DZ) but commercial (non-political) ad returnability for Algeria is
# NOT verified. Use the ad_library_manual source instead, or opt in after
# re-verifying.
# META_AD_LIBRARY_TOKEN=
# LEADHUNTER_ENABLE_META_AD_LIBRARY=false

# Optional category LLM fallback (OFF by default; strict JSON schema, cached)
# OPENAI_API_KEY=
# LEADHUNTER_ENABLE_LLM_FALLBACK=false

# Optional HTML snapshot saving for fixture building (never used at runtime)
# LEADHUNTER_SAVE_SNAPSHOTS=false

# Synthetic demo source (auto-enabled outside production)
# LEADHUNTER_ENABLE_DEMO_SOURCE=false

LOG_LEVEL=info
